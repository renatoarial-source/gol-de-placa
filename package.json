  "license": "UNLICENSED",
  "version": "1.0.0",
  "description": "Gol de Placa: pênaltis e faltas para crianças, com bonecos de blocos, para iOS e Android.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npm run build && cap sync",
    "test:e2e": "playwright test --workers=2"
  },
  "dependencies": {
    "@capacitor-community/in-app-review": "^8.0.0",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/native-purchases": "^8.9.5",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.56.1",
    "@types/three": "^0.170.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
