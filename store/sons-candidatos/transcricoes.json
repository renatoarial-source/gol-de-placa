 "narracao__fs187908__CC0.mp3": {
  "lang": "es",
  "lang_p": 0.95,
  "segments": [
   {
    "start": 0.5,
    "end": 6.5,
    "text": "En 1997, después de 150 años de historia y en NNG, decidimos replantearlo en nuestra forma de hacer banca",
    "p_speech": 0.52
   },
   {
    "start": 6.5,
    "end": 15.5,
    "text": "para adaptarnos a los nuevos tiempos, reinventarnos, de desaparecer, para crear un nuevo sistema moderno y eficaz que ya se entiende por todas partes",
    "p_speech": 0.52
   },
   {
    "start": 15.5,
    "end": 22.5,
    "text": "y que nos ha convertido en un banco directo grande, el más grande del mundo. No serás un cliente más, ni yo, ni un banco, ni nada más.",
    "p_speech": 0.52
   },
   {
    "start": 22.5,
    "end": 29.5,
    "text": "El centro de nuestra estrategia son nuestros clientes. ¿Escuchas? ¿Escuchas? ¿Escuchas? Bueno, muchas cosas más.",
    "p_speech": 0.1
   },
   {
    "start": 29.5,
    "end": 35.5,
    "text": "En todos los países y por suerte, también en España, la figura del chef, Quality Officer, se encuentra.",
    "p_speech": 0.1
   },
   {
    "start": 35.5,
    "end": 39.5,
    "text": "Hola, hola, hola. Sí, mira, estoy pensando en muchas cosas y la verdad que no puedo seguir hablando de este modo.",
    "p_speech": 0.1
   },
   {
    "start": 39.5,
    "end": 44.5,
    "text": "Yo recusco costes. ¡Uy, ganas más! Nuestro modelo de negocio se basa en la gestión eficiente de los costes.",
    "p_speech": 0.1
   },
   {
    "start": 44.5,
    "end": 48.5,
    "text": "Gracias a la tecnología de la innovación, a través de canales directos y productos sencillos,",
    "p_speech": 0.1
   },
   {
    "start": 48.5,
    "end": 53.5,
    "text": "podemos reducir nuestros datos evitando curatumilio y reivindiciendo otro deseo de retabilidad para nuestros clientes.",
    "p_speech": 0.25
   },
   {
    "start": 53.5,
    "end": 56.5,
    "text": "Esta es, sin duda, una de las claves para nuestro éxito.",
    "p_speech": 0.25
   }
  ]
 },
